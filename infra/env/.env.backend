NODE_ENV=development

APP_NAME='crossroads'
APP_PORT=3001
APP_BASE_URL='http://localhost'
APP_LOCALE='ru'
APP_GLOBAL_PREFIX='api'
APP_GLOBAL_DEFAULT_API_VERSION='1'
APP_BODY_LIMIT=1mb

ALLOWED_ORIGIN='http://localhost:3000'
CREDENTIALS=true

TZ='europe/moscow'

SWAGGER_ENABLE=true
SWAGGER_CREATE_FILE=false
SWAGGER_PATH=swagger

LOGGER_LEVEL=trace
LOGGER_FORMAT=json

DB_URI='mongodb://localhost:27017'
DB_NAME='crossroads'
DB_USERNAME=''
DB_PASS=''
DB_AUTH_SOURCE=''

JWT_SECRET=super-secret-jwt-key
JWT_ACCESS_TTL=846000
JWT_REFRESH_SECRET=refresh-token
JWT_REFRESH_TTL=846000

REDIS_USER='root'
REDIS_PASSWORD=''
REDIS_HOST='localhost'
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=3600
REDIS_MAX_RETRIES=3
REDIS_DATABASE=0


STORAGE_ENDPOINT='localhost'
STORAGE_PORT=9000
STORAGE_ACCESS_KEY='root'
STORAGE_SECRET_KEY='minio-dev-password'
STORAGE_BUCKET='crossroads'
STORAGE_USE_SSL=false

OTEL_ENABLED=true
OTEL_SERVICE_NAME='crossroad-backend'
OTEL_SERVICE_VERSION='0.1.0'
OTEL_EXPORTER_OTLP_ENDPOINT='http://localhost:4318'
OTEL_EXPORTER_OTLP_PROTOCOL='http/protobuf'
OTEL_TRACES_SAMPLER='parentbased_traceidratio'
OTEL_TRACES_SAMPLER_ARG='1.0'
